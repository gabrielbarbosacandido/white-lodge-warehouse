# Only the supplied archive is committed. Everything else under data/ is produced
# by `task build`: the unpacked source files, the NADAC download and the warehouse.
data/*
!data/sample-data.tar.gz
!data/README.md

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# dbt
transform/target/
transform/dbt_packages/
transform/logs/
transform/.user.yml

# Local
.DS_Store
# Local overrides of the source paths. Every path has a default in settings.py,
# so a clone runs without this file.
.env

# Claude Code local state
.claude/settings.local.json
.task-lock/

# Personal study notes. Not part of the submission.
STUDY.md

