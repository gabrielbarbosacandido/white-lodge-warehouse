# Template for .env. Copy it before the first run:
#
#     cp .env.example .env
#
# Every variable below is optional: settings.py carries the same value as a default,
# so the pipeline runs without this file. It exists because the brief requires that
# every source be a path the pipeline can be pointed at, rather than a hardcoded
# location. Editing .env is how you point the pipeline somewhere else without
# touching code.
#
# Precedence, narrowest first: CLI flag > environment variable > .env > settings.py.

# Source directories — every source is a path, nothing is hardcoded
WL_CLAIMS_DIR=data/landing/claims
WL_REVERTS_DIR=data/landing/reverts
WL_LOOKUPS_DIR=data/landing/lookups
WL_PHARMACIES_DIR=data/landing/pharmacies
WL_PARTNERS_DIR=data/landing/partners
WL_NADAC_DIR=data/external/nadac

# Warehouse. task and dbt both read this, so changing it moves the whole warehouse.
# Point it at a copy to exercise a failure path without risking the real file.
WL_DUCKDB_PATH=data/warehouse/white_lodge.duckdb

# NADAC source file (CMS publishes one CSV per year of weekly snapshots).
# CMS republishes weekly, so pinning this URL is what keeps cost figures stable
# across rebuilds.
WL_NADAC_URL=https://download.medicaid.gov/data/nadac-national-average-drug-acquisition-cost-08-26-2026.csv
